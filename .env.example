APP_ENV="development"
NODE_ENV="development"

# Base application URLs
APP_URL="http://localhost:3000"
NEXTAUTH_URL="http://localhost:3000"

# Security
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
NEXTAUTH_SECRET="replace-with-a-long-random-secret"

# Database
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/gestao_fardamentos_epi?schema=public"

# Optional AI integration
NEXT_PUBLIC_GEMINI_API_KEY=""

# Seed controls
SEED_DEFAULT_PASSWORD="admin12345"
SEED_INCLUDE_SAMPLE_DATA="true"
SEED_ALLOW_PRODUCTION="false"
